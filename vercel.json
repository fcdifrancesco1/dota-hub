{
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "dota-hub-neon.vercel.app"
        }
      ],
      "destination": "https://dota.hangover.com.br/$1",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/api/valve-herodata",
      "destination": "/api/valve?type=herodata"
    },
    {
      "source": "/api/leaderboard",
      "destination": "/api/valve?type=leaderboard"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/sync-opendota",
      "schedule": "0 6 * * *"
    }
  ],
  "functions": {
    "api/results.js": {
      "maxDuration": 30
    }
  }
}
