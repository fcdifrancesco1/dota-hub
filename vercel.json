{
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/sync-opendota",
      "schedule": "0 6 * * *"
    }
  ],
  "functions": {
    "api/results.js": {
      "maxDuration": 30
    }
  }
}
