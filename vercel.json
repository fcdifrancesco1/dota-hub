{
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/sync-opendota",
      "schedule": "*/10 * * * *"
    },
    {
      "path": "/api/sync-steam",
      "schedule": "*/5 * * * *"
    }
  ]
}
